// Despliegue PRIVADO (D24): una sola Worker con la app y los datos publicables, detrás de contraseña
// (worker.mjs). Plan Workers Free: sin tarjeta; cada petición pasa por la Worker y cuenta para el
// límite de 100 000 al día, de sobra para uso personal. Se despliega desde tu PC: pnpm deploy:private
{
  "name": "trazada-privada",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../.staging/private",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
