// Worker de Cloudflare solo de assets para los datos (bundles por sesión).
// Se despliega desde la máquina que ejecuta el pipeline: pnpm data:deploy
// No activar run_worker_first ni Workers Caching (dejarían de ser gratis/ilimitados).
{
  "name": "trazada-data",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "../../data",
    "not_found_handling": "none"
  }
}
