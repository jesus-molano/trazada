{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trazada/schema/manifest.schema.json",
  "title": "Manifest de sesión de Trazada",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "minReader", "generatedAt", "pipeline", "session", "drivers", "channels", "quality", "files", "attribution"],
  "properties": {
    "schema": { "const": "trazada.session" },
    "schemaVersion": { "$ref": "#/$defs/semver" },
    "minReader": { "$ref": "#/$defs/semver" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source"],
      "properties": {
        "version": { "type": "string" },
        "source": { "enum": ["fastf1", "fastf1-offline-cache", "openf1", "tracinginsights-dev", "synthetic"] },
        "fastf1": { "type": "string" },
        "apiCoreVersion": { "type": "integer" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["season", "round", "slug", "event", "type", "name", "circuit", "t0Utc", "gmtOffset", "playback", "status"],
      "properties": {
        "season": { "type": "integer", "minimum": 2018 },
        "round": { "type": "integer", "minimum": 0 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "event": { "type": "string", "description": "EventName corto (nunca el nombre oficial con patrocinadores)" },
        "type": { "enum": ["fp1", "fp2", "fp3", "sq", "sprint", "q", "race"] },
        "name": { "type": "string" },
        "circuit": { "type": "string", "pattern": "^[0-9]+-[a-z0-9]+$", "description": "{circuitKey}-{layoutId}" },
        "t0Utc": { "type": "string", "format": "date-time" },
        "gmtOffset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" },
        "playback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startMs", "endMs"],
          "properties": {
            "startMs": { "type": "integer" },
            "endMs": { "type": "integer" },
            "lightsOutMs": { "type": ["integer", "null"] }
          }
        },
        "totalLaps": { "type": ["integer", "null"], "minimum": 0 },
        "status": { "enum": ["ok", "partial", "no-position"] }
      }
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "tla", "first", "last", "team", "color"],
        "properties": {
          "number": { "type": "string", "pattern": "^[0-9]{1,2}$" },
          "tla": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "first": { "type": "string" },
          "last": { "type": "string" },
          "team": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "finish": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["classified", "retired", "unknown"] },
              "position": { "type": ["integer", "null"] },
              "lapsDown": { "type": ["integer", "null"] }
            }
          }
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drs", "elevation"],
      "properties": {
        "drs": { "enum": ["present", "absent"] },
        "overtakeWindows": { "enum": ["raceControl", "none"] },
        "elevation": { "enum": ["real", "flat"] },
        "timingStream": { "enum": ["present", "absent"] },
        "marshalSectors": { "enum": ["present", "absent"] }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "estimated"],
      "properties": {
        "coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pos", "car"],
            "properties": { "pos": { "type": "number", "minimum": 0, "maximum": 1 }, "car": { "type": "number", "minimum": 0, "maximum": 1 } }
          }
        },
        "centerlineClosureM": { "type": "number" },
        "elevationRangeM": { "type": "number" },
        "estimated": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion", "car", "timing", "events", "circuit"],
      "properties": {
        "motion": { "$ref": "#/$defs/file" },
        "car": { "$ref": "#/$defs/file" },
        "timing": { "$ref": "#/$defs/file" },
        "events": { "$ref": "#/$defs/file" },
        "circuit": { "$ref": "#/$defs/file" }
      }
    },
    "attribution": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "layout", "compression"],
      "properties": {
        "path": { "type": "string", "description": "Relativa al manifest (o a /v1/ para el circuito)" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "layout": { "type": "string", "pattern": "^[a-z]+@[0-9]+$" },
        "compression": { "enum": ["gzip", "zstd", "none"] }
      }
    }
  }
}
