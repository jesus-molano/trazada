{
  "layout": "motion",
  "revision": 1,
  "description": "Posición de cada coche proyectada sobre el circuito canónico. Coches concatenados, ordenados por coche y tiempo.",
  "tables": {
    "cars": {
      "columns": {
        "car": {
          "type": "u8",
          "description": "Número del coche"
        },
        "start": {
          "type": "u32",
          "description": "Primera fila del coche en pos"
        },
        "count": {
          "type": "u32",
          "description": "Filas del coche en pos"
        }
      }
    },
    "pos": {
      "columns": {
        "t": {
          "type": "i32",
          "encoding": "delta",
          "shuffle": true,
          "unit": "ms",
          "decode": "f64",
          "description": "Tiempo de sesión"
        },
        "path": {
          "type": "u8",
          "enum": "path",
          "description": "0 pista, 1 pit lane, 2 sin dato"
        },
        "s": {
          "type": "i32",
          "encoding": "delta",
          "shuffle": true,
          "unit": "dm",
          "scale": 0.1,
          "decode": "f64",
          "description": "Distancia acumulada sobre la línea canónica (m tras decodificar, resolución 1 dm); en pit, equivalente en pista"
        },
        "projErr": {
          "type": "u8",
          "unit": "dm",
          "description": "Distancia de la muestra a la línea (saturada a 255)"
        }
      }
    }
  }
}
