{
  "layout": "circuit",
  "revision": 1,
  "description": "Circuito canónico de un trazado: línea central a paso fijo, pit lane, curvas y sectores de comisarios. Coordenadas en metros, orientación del mapa oficial, centradas.",
  "tables": {
    "centerline": {
      "columns": {
        "x": { "type": "f32", "unit": "m" },
        "y": { "type": "f32", "unit": "m" },
        "z": { "type": "f32", "unit": "m" }
      }
    },
    "pitlane": {
      "columns": {
        "x": { "type": "f32", "unit": "m" },
        "y": { "type": "f32", "unit": "m" },
        "z": { "type": "f32", "unit": "m" }
      }
    },
    "corners": {
      "columns": {
        "number": { "type": "u8" },
        "letter": { "type": "u8", "description": "Código ASCII de la letra (0 = sin letra)" },
        "s": { "type": "f32", "unit": "m" },
        "x": { "type": "f32", "unit": "m" },
        "y": { "type": "f32", "unit": "m" },
        "angle": { "type": "f32", "unit": "deg" }
      }
    },
    "marshalSectors": {
      "columns": {
        "number": { "type": "u8" },
        "sStart": { "type": "f32", "unit": "m" },
        "sEnd": { "type": "f32", "unit": "m", "description": "Puede ser menor que sStart si el sector cruza s = 0" }
      }
    }
  }
}
